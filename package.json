{
    "name": "dfreds-convenient-effects",
    "version": "1.0.0",
    "description": "Adds easy to use toggleable active effects for common use cases",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "stage": "tsc && npm run clean && vite build --mode stage",
        "dev": "tsc && npm run clean && vite build --mode development",
        "clean": "tsx ./build/clean.ts",
        "hot": "vite serve",
        "watch": "tsc && npm run clean && vite build --watch --mode development",
        "link": "tsx ./build/link-foundry.ts",
        "lint": "npm run lint:ts && npm run prettier:scss",
        "lint:ts": "eslint ./src",
        "prettier:scss": "prettier --check src/styles",
        "lint:fix": "eslint ./src --fix && prettier --write src/styles"
    },
    "author": "DFreds (https://github.com/DFreds)",
    "license": "MIT",
    "engines": {
        "node": ">=24.14.1"
    },
    "devDependencies": {
        "@dfreds/foundry-types": "^14.365.2",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^1.2.0",
        "@foundryvtt/foundryvtt-cli": "^3.0.3",
        "@types/jquery": "^4.0.0",
        "@types/node": "^25.6.0",
        "@types/prompts": "^2.4.9",
        "eslint": "^10.3.0",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.6.0",
        "gsap": "3.11.5",
        "prettier": "^3.8.3",
        "prompts": "^2.4.2",
        "sass": "^1.99.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "vite-plugin-checker": "^0.13.0",
        "vite-plugin-static-copy": "^4.1.0"
    }
}
